rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes on every other collection/path
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'whdgur0839@gmail.com';
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'category', 'content', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'content', 'createdAt'])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 100
        && data.category is string
        && data.category in ['사진 합성', '스타일 변환', '캐릭터·포스터']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 10000
        && data.createdAt is timestamp;
    }

    // prompts collection: public read for everyone; create, update, delete restricted to verified admin
    match /prompts/{promptId} {
      allow get: if isValidId(promptId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(promptId)
        && isValidPrompt(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(promptId)
        && isValidPrompt(incoming())
        && (
          // Action: Update prompt fields while keeping createdAt immutable
          incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content'])
        );
      allow delete: if isAdmin() && isValidId(promptId);
    }
  }
}
